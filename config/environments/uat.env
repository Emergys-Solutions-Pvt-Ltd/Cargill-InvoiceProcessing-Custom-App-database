# UAT deployment policy (no secrets: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD come from Vela secrets)
DEPLOY_ENV=uat
DB_SSLMODE=require
# UAT deploys only through a Vela deployment carrying the reviewed plan digest (approved_plan_digest)
REQUIRE_PLAN_APPROVAL=true
ALLOW_DESTRUCTIVE_DEFAULT=false
LOCK_TIMEOUT=30s
