# DEV deployment policy (no secrets: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD come from Vela secrets)
DEPLOY_ENV=dev
DB_SSLMODE=require
# DEV deploys automatically after a merge to the dev branch; the plan digest is not required
REQUIRE_PLAN_APPROVAL=false
# Destructive steps (DROP TABLE / DROP COLUMN / DROP FUNCTION ...) still need ALLOW_DESTRUCTIVE=true
ALLOW_DESTRUCTIVE_DEFAULT=false
LOCK_TIMEOUT=30s
